generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Status enums are technical persistence codes only.
// Display labels, schedules, dictionaries, and business rules live in data.
// ---------------------------------------------------------------------------

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
  PENDING_ACTIVATION
}

enum EntityStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum ProgramStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
  SUSPENDED
}

enum MealRecordStatus {
  SERVED
  MISSED
  /// Missed because the student was outside on an approved leave.
  MISSED_LEAVE
  CANCELLED
  OVERRIDDEN
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CHECKED_OUT
  RETURNED
  OVERDUE
  CANCELLED
  EXPIRED
}

enum GateAction {
  EXIT
  RETURN
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  UNDER_INVESTIGATION
  AWAITING_DECISION
  ACTION_ASSIGNED
  CLOSED
  APPEALED
}

enum DisciplinaryActionStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ImportMode {
  ADD_ONLY
  UPDATE_EXISTING
  REPLACE_EXISTING
}

enum ImportJobStatus {
  PENDING
  VALIDATING
  PREVIEW
  COMPLETED
  FAILED
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
  JSON
}

enum ActivityReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

/// Top-level tenant. Every operational entity belongs to an organization.
model Organization {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  timezone    String       @default("Africa/Addis_Ababa")
  locale      String       @default("en")
  branding    Json?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?
  updatedById String?

  campuses              Campus[]
  academicYears         AcademicYear[]
  programs              Program[]
  students              Student[]
  users                 UserOrganizationAssignment[]
  roles                 Role[]
  settings              SystemSetting[]
  referenceCategories   ReferenceDataCategory[]
  mealSessionConfigs    MealSessionConfig[]
  modules               OrganizationModule[]
  customFieldDefinitions CustomFieldDefinition[]
  importJobs            ImportJob[]
  mealRecords           MealRecord[]
  leaveTypes            LeaveType[]
  leaveRequests         LeaveRequest[]
  gateLogs              GateLog[]
  incidentTypes         IncidentType[]
  disciplinaryActionTypes DisciplinaryActionType[]
  disciplinaryIncidents DisciplinaryIncident[]
  activityCategories    ActivityCategory[]
  activityReports       ActivityReport[]
  auditLogs             AuditLog[]
  businessRules         BusinessRule[]
}

/// Registry of platform capability modules (meals, reports, ...).
/// Enabling a module for an org does not require schema changes.
model PlatformModule {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  isCore         Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organizations OrganizationModule[]
}

model OrganizationModule {
  id             String   @id @default(cuid())
  organizationId String
  moduleKey      String
  isEnabled      Boolean  @default(true)
  config         Json?
  enabledAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       PlatformModule @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@unique([organizationId, moduleKey])
  @@index([organizationId])
}

/// Configurable business rules (lockout threshold, meal uniqueness, etc.).
/// `scopeKey` is "__platform__" for defaults, or the organizationId for overrides.
model BusinessRule {
  id             String   @id @default(cuid())
  organizationId String?
  scopeKey       String   @default("__platform__")
  key            String
  value          Json
  description    String?
  updatedAt      DateTime @updatedAt
  updatedById    String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, key])
  @@index([key])
}

/// Org-scoped or platform-default dictionaries (departments, meal codes, ...).
/// `scopeKey` is "__platform__" for shared catalogs, or organizationId for overrides.
model ReferenceDataCategory {
  id             String   @id @default(cuid())
  organizationId String?
  scopeKey       String   @default("__platform__")
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ReferenceDataItem[]

  @@unique([scopeKey, key])
}

model ReferenceDataItem {
  id         String       @id @default(cuid())
  categoryId String
  code       String
  label      String
  sortOrder  Int          @default(0)
  metadata   Json?
  status     EntityStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  category ReferenceDataCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, code])
  @@index([categoryId])
}

/// Extend any entity with org-defined fields without altering core tables.
model CustomFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String
  entityType     String
  fieldKey       String
  label          String
  fieldType      CustomFieldType @default(TEXT)
  options        Json?
  isRequired     Boolean         @default(false)
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@unique([organizationId, entityType, fieldKey])
  @@index([organizationId, entityType])
}

model CustomFieldValue {
  id           String   @id @default(cuid())
  definitionId String
  entityId     String
  value        Json
  updatedAt    DateTime @updatedAt

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([entityId])
}

model AcademicYear {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime?
  endDate        DateTime?
  /// Open for operations (Part 4: Active)
  isActive       Boolean   @default(true)
  /// Working year for the organization
  isCurrent      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programs     Program[]
  students     Student[]
  mealRecords  MealRecord[]
  mentors         Mentor[]
  activityReports ActivityReport[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
}

model Campus {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  shortName      String
  address        String?
  city           String?
  /// Legacy/free-form location text (optional)
  location       String?
  logoUrl        String?
  description    String?
  status         EntityStatus @default(ACTIVE)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?
  updatedById    String?

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programs           Program[]
  students           Student[]
  userAssignments    UserCampusAssignment[]
  mealRecords        MealRecord[]
  mealSessionConfigs MealSessionConfig[]
  importJobs         ImportJob[]
  leaveRequests      LeaveRequest[]
  gateLogs           GateLog[]
  disciplinaryIncidents DisciplinaryIncident[]
  mentors            Mentor[]
  activityReports    ActivityReport[]

  @@unique([organizationId, shortName])
  @@index([organizationId])
  @@index([deletedAt])
}

model Program {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  capacity       Int?
  status         ProgramStatus @default(ACTIVE)
  startDate      DateTime?
  endDate        DateTime?
  campusId       String
  academicYearId String
  coordinatorId  String?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  updatedById    String?

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus            Campus                  @relation(fields: [campusId], references: [id])
  academicYear      AcademicYear            @relation(fields: [academicYearId], references: [id])
  coordinator       User?                   @relation("ProgramCoordinator", fields: [coordinatorId], references: [id])
  students          Student[]
  userAssignments   UserProgramAssignment[]
  mealRecords       MealRecord[]
  leaveRequests     LeaveRequest[]
  disciplinaryIncidents DisciplinaryIncident[]
  mentors           Mentor[]
  activityReports   ActivityReport[]

  @@unique([campusId, name, academicYearId])
  @@index([organizationId])
  @@index([campusId])
  @@index([academicYearId])
  @@index([deletedAt])
}

model User {
  id                  String        @id @default(cuid())
  /// Login identifier (unique). Prefer this over email for sign-in.
  username            String        @unique
  /// Optional contact / recovery email
  email               String?       @unique
  passwordHash        String
  fullName            String
  phone               String?
  status              AccountStatus @default(PENDING_ACTIVATION)
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organizationAssignments UserOrganizationAssignment[]
  roles                   UserRole[]
  campusAssignments       UserCampusAssignment[]
  programAssignments      UserProgramAssignment[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  coordinatedPrograms     Program[]                    @relation("ProgramCoordinator")
  mealRecordsAsMentor     MealRecord[]                 @relation("MealMentor")
  importJobs              ImportJob[]
  auditLogs               AuditLog[]
  approvalsGiven          ApprovalRecord[]             @relation("ApprovalApprover")
  leaveRequestsCreated    LeaveRequest[]               @relation("LeaveCreatedBy")
  leaveRequestsApproved   LeaveRequest[]               @relation("LeaveApprovedBy")
  gateLogsAsOfficer       GateLog[]                    @relation("GateOfficer")
  incidentsReported       DisciplinaryIncident[]       @relation("IncidentReportedBy")
  incidentsAssigned       DisciplinaryIncident[]       @relation("IncidentAssignedTo")
  incidentsDecided        DisciplinaryIncident[]       @relation("IncidentDecidedBy")
  disciplinaryActionsAssigned DisciplinaryAction[]     @relation("DisciplinaryActionAssignedBy")
  /// Camp-specific mentor assignment (one campus; optional program).
  mentorProfile           Mentor?
  activityReportsSubmitted ActivityReport[]            @relation("ActivitySubmittedBy")
  activityReportsReviewed  ActivityReport[]            @relation("ActivityReviewedBy")
  activityMediaUploaded    ActivityMedia[]             @relation("ActivityMediaUploadedBy")
}

/// Camp-bound mentor profile. Mentors are never global — they belong to one campus.
model Mentor {
  id             String        @id @default(cuid())
  userId         String        @unique
  campusId       String
  programId      String?
  academicYearId String
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus       Campus       @relation(fields: [campusId], references: [id])
  program      Program?     @relation(fields: [programId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([campusId])
  @@index([programId])
  @@index([academicYearId])
  @@index([status])
}

model UserOrganizationAssignment {
  userId         String
  organizationId String
  isDefault      Boolean  @default(false)
  assignedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

/// System roles: scopeKey = "__platform__". Custom roles: scopeKey = organizationId.
model Role {
  id             String   @id @default(cuid())
  organizationId String?
  scopeKey       String   @default("__platform__")
  name           String
  displayName    String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([scopeKey, name])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId         String
  roleId         String
  organizationId String?
  startsAt       DateTime?
  endsAt         DateTime?
  assignedAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([organizationId])
}

model UserCampusAssignment {
  userId     String
  campusId   String
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@id([userId, campusId])
}

model UserProgramAssignment {
  userId     String
  programId  String
  assignedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([userId, programId])
}

model Student {
  id               String        @id @default(cuid())
  organizationId   String
  /// External ID issued by the organization (also used as barcode by default).
  studentId        String
  barcode          String
  fullName         String
  gender           String?
  department       String?
  educationLevel   String?
  email            String?
  phone            String?
  emergencyContact String?
  photoUrl         String?
  status           StudentStatus @default(ACTIVE)
  campusId         String
  programId        String
  academicYearId   String
  metadata         Json?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdById      String?
  updatedById      String?
  deletedById      String?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus            Campus             @relation(fields: [campusId], references: [id])
  program           Program            @relation(fields: [programId], references: [id])
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  mealRecords       MealRecord[]
  leaveRequests     LeaveRequest[]
  gateLogs          GateLog[]
  disciplinaryIncidents DisciplinaryIncident[]
  activityParticipations ActivityParticipant[]

  @@unique([organizationId, studentId])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([campusId])
  @@index([programId])
  @@index([barcode])
  @@index([fullName])
  @@index([department])
  @@index([studentId])
  @@index([deletedAt])
}

/// Meal session windows are fully configurable per org (and optionally campus).
/// `code` is a stable key (e.g. BREAKFAST); label/times come from data.
/// `scopeKey` is "__org__" for org-wide defaults, or the campusId for overrides.
model MealSessionConfig {
  id             String   @id @default(cuid())
  organizationId String
  campusId       String?
  scopeKey       String   @default("__org__")
  code           String
  name           String
  startTime      String
  endTime        String
  gracePeriod    Int       @default(0)
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id])

  @@unique([organizationId, scopeKey, code])
  @@index([organizationId, code])
  @@index([deletedAt])
}

model MealRecord {
  id             String           @id @default(cuid())
  organizationId String
  studentId      String
  campusId       String
  programId      String
  academicYearId String
  /// ISO week number (Part 5: weekNumber)
  weekNumber     Int?
  /// Day of week label (Part 5: dayOfWeek)
  dayOfWeek      String?
  mealDate       DateTime         @db.Date
  /// Matches MealSessionConfig.code for the organization (session reference).
  mealCode       String
  servedAt       DateTime         @default(now())
  mentorId       String?
  scannerDevice  String?
  location       String?
  status         MealRecordStatus @default(SERVED)
  notes          String?
  overrideReason String?
  /// When status is MISSED_LEAVE, links to the leave that caused the miss.
  leaveRequestId String?
  approvedById   String?
  approvedAt     DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id])
  campus       Campus        @relation(fields: [campusId], references: [id])
  program      Program       @relation(fields: [programId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  mentor       User?         @relation("MealMentor", fields: [mentorId], references: [id])
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id])

  @@unique([studentId, mealDate, mealCode])
  @@index([organizationId, mealDate])
  @@index([campusId, mealDate])
  @@index([mealCode, mealDate])
  @@index([studentId])
  @@index([mentorId])
  @@index([mealDate])
  @@index([leaveRequestId])
}

model ImportJob {
  id             String          @id @default(cuid())
  organizationId String
  uploadedById   String
  campusId       String?
  originalFile   String
  mode           ImportMode      @default(ADD_ONLY)
  status         ImportJobStatus @default(PENDING)
  totalRows      Int             @default(0)
  rowsImported   Int             @default(0)
  rowsFailed     Int             @default(0)
  durationMs     Int?
  errorReportUrl String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  campus       Campus?      @relation(fields: [campusId], references: [id])

  @@index([organizationId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  organizationId String?
  userId         String?
  roleName       String?
  action         String
  resource       String?
  resourceId     String?
  previousValue  Json?
  newValue       Json?
  campusId       String?
  programId      String?
  ipAddress      String?
  userAgent      String?

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([campusId])
}

model ApprovalRecord {
  id            String   @id @default(cuid())
  resourceType  String
  resourceId    String
  action        String
  reason        String
  previousValue Json?
  newValue      Json?
  approverId    String
  approvedAt    DateTime @default(now())

  approver User @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([resourceType, resourceId])
}

/// Platform defaults: scopeKey = "__platform__". Org overrides: scopeKey = organizationId.
model SystemSetting {
  id             String   @id @default(cuid())
  organizationId String?
  scopeKey       String   @default("__platform__")
  key            String
  value          Json
  description    String?
  updatedAt      DateTime @updatedAt
  updatedById    String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, key])
  @@index([key])
}

/// Configurable leave reasons (Church, Medical, …). Soft-disable via `active`.
model LeaveType {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
}

/// Leave & gate pass request. Soft-cancel only — history is never hard-deleted.
model LeaveRequest {
  id                 String             @id @default(cuid())
  organizationId     String
  leaveNumber        String
  studentId          String
  campusId           String
  programId          String
  leaveTypeId        String
  reason             String
  destination        String
  expectedExitTime   DateTime
  expectedReturnTime DateTime
  status             LeaveRequestStatus @default(PENDING)
  notes              String?
  rejectionReason    String?
  approvedById       String?
  approvedAt         DateTime?
  actualExitTime     DateTime?
  actualReturnTime   DateTime?
  createdById        String
  cancelledAt        DateTime?
  cancelledById      String?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id])
  campus       Campus       @relation(fields: [campusId], references: [id])
  program      Program      @relation(fields: [programId], references: [id])
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])
  createdBy    User         @relation("LeaveCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?        @relation("LeaveApprovedBy", fields: [approvedById], references: [id])
  gateLogs     GateLog[]
  mealRecords  MealRecord[]

  @@unique([organizationId, leaveNumber])
  @@index([organizationId, status])
  @@index([studentId, status])
  @@index([campusId, status])
  @@index([expectedReturnTime])
  @@index([deletedAt])
}

/// Immutable exit/return scans at the gate.
model GateLog {
  id             String     @id @default(cuid())
  organizationId String
  leaveRequestId String
  studentId      String
  campusId       String?
  action         GateAction
  gateOfficerId  String
  gateLocation   String?
  scannedAt      DateTime   @default(now())
  remarks        String?
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  campus       Campus?      @relation(fields: [campusId], references: [id])
  gateOfficer  User         @relation("GateOfficer", fields: [gateOfficerId], references: [id])

  @@index([organizationId, scannedAt])
  @@index([leaveRequestId])
  @@index([studentId, scannedAt])
  @@index([action, scannedAt])
}

/// Configurable incident categories (Attendance, Behavior, Camp Rules, …).
model IncidentType {
  id             String    @id @default(cuid())
  organizationId String
  category       String
  name           String
  description    String?
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidents    DisciplinaryIncident[]

  @@unique([organizationId, category, name])
  @@index([organizationId])
  @@index([deletedAt])
}

/// Catalog of disciplinary outcomes (Verbal Warning, Suspension, …).
model DisciplinaryActionType {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  /// When true, meal station may show an active-case alert for this action.
  affectsMeals   Boolean   @default(false)
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actions      DisciplinaryAction[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
}

/// Full disciplinary case from report through resolution.
model DisciplinaryIncident {
  id               String           @id @default(cuid())
  organizationId   String
  incidentNumber   String
  studentId        String
  campusId         String
  programId        String
  incidentTypeId   String
  severity         IncidentSeverity @default(LOW)
  status           IncidentStatus   @default(OPEN)
  occurredAt       DateTime
  location         String?
  description      String
  witnesses        String?
  evidenceUrl      String?
  investigationNotes String?
  decisionNotes    String?
  acknowledgmentNotes String?
  acknowledgedAt   DateTime?
  closedAt         DateTime?
  leaveRequestId   String?
  reportedById     String
  assignedToId     String?
  decidedById      String?
  decidedAt        DateTime?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student                  @relation(fields: [studentId], references: [id])
  campus       Campus                   @relation(fields: [campusId], references: [id])
  program      Program                  @relation(fields: [programId], references: [id])
  incidentType IncidentType             @relation(fields: [incidentTypeId], references: [id])
  reportedBy   User                     @relation("IncidentReportedBy", fields: [reportedById], references: [id])
  assignedTo   User?                    @relation("IncidentAssignedTo", fields: [assignedToId], references: [id])
  decidedBy    User?                    @relation("IncidentDecidedBy", fields: [decidedById], references: [id])
  actions      DisciplinaryAction[]

  @@unique([organizationId, incidentNumber])
  @@index([organizationId, status])
  @@index([studentId, status])
  @@index([campusId, status])
  @@index([severity, status])
  @@index([reportedById])
  @@index([occurredAt])
  @@index([deletedAt])
}

model DisciplinaryAction {
  id             String                    @id @default(cuid())
  organizationId String
  incidentId     String
  actionTypeId   String
  description    String?
  assignedById   String
  startDate      DateTime?
  endDate        DateTime?
  completedAt    DateTime?
  status         DisciplinaryActionStatus  @default(PENDING)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  incident   DisciplinaryIncident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actionType DisciplinaryActionType @relation(fields: [actionTypeId], references: [id])
  assignedBy User                   @relation("DisciplinaryActionAssignedBy", fields: [assignedById], references: [id])

  @@index([incidentId])
  @@index([organizationId, status])
  @@index([actionTypeId])
}

/// Configurable activity report categories (Training Session, Workshop, …).
model ActivityCategory {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports      ActivityReport[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
}

/// Official campus daily/activity report with media and approval workflow.
model ActivityReport {
  id                 String               @id @default(cuid())
  organizationId     String
  reportNumber       String
  title              String
  categoryId         String
  campusId           String
  programId          String?
  academicYearId     String
  reportDate         DateTime             @db.Date
  startTime          String?
  endTime            String?
  location           String?
  objectives         String?
  description        String
  activitiesPerformed String?
  outcomes           String?
  challenges         String?
  recommendations    String?
  participantCount   Int                  @default(0)
  status             ActivityReportStatus @default(DRAFT)
  reviewNotes        String?
  submittedById      String
  reviewedById       String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  publishedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ActivityCategory     @relation(fields: [categoryId], references: [id])
  campus       Campus               @relation(fields: [campusId], references: [id])
  program      Program?             @relation(fields: [programId], references: [id])
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  submittedBy  User                 @relation("ActivitySubmittedBy", fields: [submittedById], references: [id])
  reviewedBy   User?                @relation("ActivityReviewedBy", fields: [reviewedById], references: [id])
  media        ActivityMedia[]
  participants ActivityParticipant[]

  @@unique([organizationId, reportNumber])
  @@index([organizationId, status])
  @@index([campusId, reportDate])
  @@index([categoryId])
  @@index([submittedById])
  @@index([reportDate])
  @@index([deletedAt])
}

model ActivityMedia {
  id           String   @id @default(cuid())
  reportId     String
  fileName     String
  originalName String
  fileType     String
  mimeType     String
  fileSize     Int
  storagePath  String
  caption      String?
  sortOrder    Int      @default(0)
  uploadedById String
  uploadedAt   DateTime @default(now())

  report     ActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("ActivityMediaUploadedBy", fields: [uploadedById], references: [id])

  @@index([reportId])
  @@index([fileType])
  @@index([uploadedById])
}

model ActivityParticipant {
  id        String   @id @default(cuid())
  reportId  String
  studentId String
  createdAt DateTime @default(now())

  report  ActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([reportId, studentId])
  @@index([studentId])
}


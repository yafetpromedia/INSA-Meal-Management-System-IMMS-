# Docker Compose: postgresql://imms:imms_dev_password@localhost:5432/imms?schema=public
# Local Postgres may use another port (e.g. 8000)
DATABASE_URL="postgresql://imms:imms_dev_password@localhost:5432/imms?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=30
PASSWORD_RESET_EXPIRES_MINUTES=60
SESSION_INACTIVE_MINUTES=480
SEED_SUPERADMIN_EMAIL="superadmin@insa.gov.et"
SEED_SUPERADMIN_PASSWORD="ChangeMe!123"
